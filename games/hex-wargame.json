  "components": {
    "unit": {
      "owner": "per_player",
      "count": 20,
      "types": {
        "infantry": { "count": 6, "properties": { "attack": 2, "defense": 3, "movement_points": 4, "steps": 2 } },
        "armor": { "count": 4, "properties": { "attack": 6, "defense": 4, "movement_points": 8, "steps": 2 } },
        "mechanized": { "count": 4, "properties": { "attack": 4, "defense": 3, "movement_points": 6, "steps": 2 } },
        "artillery": { "count": 3, "properties": { "attack": 3, "defense": 1, "movement_points": 3, "steps": 1 } },
        "headquarters": { "count": 1, "properties": { "attack": 0, "defense": 1, "movement_points": 4, "steps": 1 } },
        "recon": { "count": 2, "properties": { "attack": 1, "defense": 1, "movement_points": 10, "steps": 1 } }
      },
      "note": "NATO-style counters. Steps = damage capacity before elimination."
    }
  },
  "turn_order": {
    "type": "alternating",
    "players": ["Blue", "Red"]
  },
  "phases": [
    { "name": "reinforcement", "server_action": "place_reinforcements", "note": "Place available reinforcements on friendly map edge hexes." },
    { "name": "movement", "action": "move_piece", "note": "Move units within MP budget. Terrain costs, ZOC restrictions apply." },
    { "name": "combat", "action": "declare_action", "note": "Mandatory attacks vs adjacent enemies. Resolve via CRT with d6." },
    { "name": "exploitation", "action": "move_piece", "note": "Armor and recon may move again (breakthrough)." },
    { "name": "supply", "resolve": "check_supply_lines", "note": "Trace supply from each unit to HQ or friendly map edge. Out-of-supply: halved attack, no advance after combat." }
  ],
  "rules": {
    "terrain_movement": {
      "definition": "Each terrain type costs different movement points to enter",
      "constraints": [
        "clear costs 1 MP",
        "forest costs 2 MP",
        "hills costs 2 MP",
        "mountain costs 3 MP",
        "road costs 1 MP",
        "town costs 1 MP",
        "bridge costs 1 MP",
        "river is impassable"
      ]
    },
    "zone_of_control": {
      "definition": "Hexes adjacent to enemy units exert ZOC",
      "constraints": [
        "entering enemy ZOC costs all remaining MP",
        "ZOC-to-ZOC movement is prohibited",
        "retreating through enemy ZOC causes additional step loss"
      ]
    },
    "combat_resolution": {
      "definition": "Compare attack vs defense strengths, apply terrain modifier, roll d6 on CRT",
      "trigger": "combat phase",
      "effect": "DE (eliminated), DR (retreat), EX (exchange), AR (attacker retreat), NE (no effect)"
    },
    "stacking": {
      "definition": "Maximum 3 units per hex",
      "constraint": "stacking_limit enforced by engine"
    },
    "road_bonus": {
      "definition": "Movement along a road costs 1 MP regardless of underlying terrain",
      "constraint": "unit must follow contiguous road hexes to benefit"
    },
    "mandatory_combat": {
      "definition": "Units adjacent to enemy units MUST declare attack in combat phase",
      "trigger": "combat phase",
      "constraint": "all units in enemy ZOC must participate in an attack"
    },
    "retreat": {
      "definition": "DR result forces defender back 1-2 hexes away from attacker",
      "constraints": [
        "retreating unit must move 1-2 hexes away from attacker",
        "retreat into enemy ZOC causes one additional step loss per ZOC hex entered",
        "retreat off map edge eliminates the unit",
        "retreat into a hex exceeding stacking limit is prohibited; unit takes step loss instead"
      ]
    },
    "advance_after_combat": {
      "definition": "After DE or DR result, attacker may advance into the vacated hex",
      "constraint": "advance is optional and costs no MP"
    },
    "step_losses": {
      "definition": "Units have 1-2 steps representing damage capacity",
      "constraints": [
        "losing a step halves attack and defense values, rounded up",
        "losing all steps eliminates the unit, moved to casualties zone",
        "step losses are distributed by owning player among participating units"
      ]
    },
    "supply_line": {
      "definition": "Each unit must trace a path of max 10 hexes to HQ or friendly map edge",
      "constraints": [
        "supply path may not pass through unoccupied enemy ZOC hexes",
        "supply path may not pass through impassable terrain",
        "out-of-supply units have attack halved, rounded down",
        "out-of-supply units may not advance after combat"
      ]
    },
    "river_crossing": {
      "definition": "River hexes are impassable and cannot be entered",
      "constraint": "units may only cross the river at bridge hexes"
    },
    "exploitation_eligibility": {
      "definition": "Only armor and recon units may move in exploitation phase",
      "constraint": "unit type must be armor or recon"
    }
  },
  "library": {
    "terrain_cost": "cell_property(board, col, row, 'terrain') based lookup",
    "attack_odds": "sum(attacker_strengths) / sum(defender_strengths + terrain_bonus)",
    "crt_columns": "1:3, 1:2, 1:1, 2:1, 3:1, 4:1, 5:1, 6:1",
    "supply_trace": "bfs(unit_hex, max_depth=10, avoid=enemy_zoc AND impassable, target=hq OR friendly_edge)",
    "step_loss_calc": "if steps_remaining == 1: eliminated, move to casualties; else: halve attack/defense rounded up, decrement steps",
    "retreat_validation": "valid_hexes = neighbors(defender_hex) where distance_from(attacker_hex) > current AND not impassable AND stacking_ok"
  },
  "end_conditions": [
    {
      "result": "win",
      "player": "current",
      "condition": "opponent has no units remaining",
      "name": "elimination"
    },
    {
      "result": "win",
      "condition": "after turn 10, player controlling more objective hexes wins",
      "name": "objective_control"
    },
    {
      "result": "draw",
      "condition": "after turn 10, equal objective control",
      "name": "draw"
    }
  ],
  "authority": {
    "server_only": ["roll_dice", "resolve_combat", "place_reinforcements"],
    "client_verifiable": ["movement_cost", "stacking_limit", "zoc_check"],
    "wasm_required": ["crt_lookup", "terrain_cost_calculation", "zoc_computation", "victory_point_scoring", "supply_line_tracing"]
  },
  "wasm_module": "wargame.wasm"
}

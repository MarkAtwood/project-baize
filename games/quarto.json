{
  "$schema": "../schema/game-definition.schema.json",
  "game": {
    "name": "Quarto",
    "players": ["Player1", "Player2"],
    "information": "perfect"
  },
  "zones": {
    "board": {
      "zone_type": "grid",
      "dimensions": [4, 4],
      "visibility": "public",
      "labels": {
        "files": ["a", "b", "c", "d"],
        "ranks": [1, 2, 3, 4]
      }
    },
    "available": {
      "zone_type": "set",
      "visibility": "public",
      "capacity": 16,
      "note": "Pool of unplaced pieces. Opponent selects from here."
    }
  },
  "components": {
    "piece": {
      "owner": "neutral",
      "count": 16,
      "properties": {
        "height": ["tall", "short"],
        "color": ["dark", "light"],
        "shape": ["round", "square"],
        "top": ["hollow", "solid"]
      },
      "note": "16 unique pieces, each a unique combination of 4 binary properties."
    }
  },
  "turn_order": {
    "type": "alternating",
    "players": ["Player1", "Player2"],
    "actions_per_turn": 1,
    "mandatory": true
  },
  "phases": [
    {
      "name": "select",
      "action": "select_piece(available/piece)",
      "note": "Current player selects a piece from the pool for the opponent to place."
    },
    {
      "name": "place",
      "action": "place(piece, board/cell)",
      "note": "Current player places the previously selected piece onto an empty board cell."
    }
  ],
  "library": {
    "four_sharing_property": "lines_4.exists(line, line.all(cell, cell != '' && cell == line[0]))",
    "board_full": "occupied_count == cell_count"
  },
  "rules": {
    "selection": {
      "action": "select_piece(available/piece)",
      "constraint": "piece is in available pool"
    },
    "placement": {
      "action": "place(piece, board/cell)",
      "constraint": "cell is empty"
    }
  },
  "end_conditions": [
    {
      "result": "win",
      "player": "current",
      "condition": "four_sharing_property",
      "name": "quarto"
    },
    {
      "result": "draw",
      "condition": "board_full",
      "name": "board_full"
    }
  ],
  "authority": {
    "server_only": [],
    "client_verifiable": [
      "select_piece(available/piece)",
      "place(piece, board/cell)"
    ],
    "wasm_required": [
      "shared_property_line_detection"
    ]
  }
}

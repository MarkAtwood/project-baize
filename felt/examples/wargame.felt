-- Wargame extension: terrain-aware movement costs and VP scoring
--
-- Cell property "terrain" on the board zone controls movement costs
-- and defense bonuses. Unit type_of controls movement point budgets.
-- Cell property "objective" marks VP-scoring hexes.

type Score = { player: String, points: Int, breakdown: List Entry }
type Entry = { category: String, points: Int }

-- Terrain movement cost lookup
fn terrain_cost(board: Zone, c: Cell) -> Int =
  let terrain = cell_property board (col c) (row c) "terrain" in
  if terrain == "mountain" then 3
  else if terrain == "forest" then 2
  else if terrain == "hills" then 2
  else if terrain == "swamp" then 3
  else if terrain == "road" then 1
  else if terrain == "town" then 1
  else if terrain == "river" then 4
  else 1

-- Terrain defense modifier
fn defense_bonus(board: Zone, c: Cell) -> Int =
  let terrain = cell_property board (col c) (row c) "terrain" in
  if terrain == "mountain" then 3
  else if terrain == "forest" then 1
  else if terrain == "hills" then 2
  else if terrain == "town" then 2
  else if terrain == "swamp" then -1
  else 0

-- Movement point budget by unit type
fn movement_points_for(comp: Component) -> Int =
  let unit_type = type_of comp in
  if unit_type == "infantry" then 4
  else if unit_type == "armor" then 8
  else if unit_type == "mechanized" then 6
  else if unit_type == "cavalry" then 6
  else if unit_type == "artillery" then 3
  else if unit_type == "headquarters" then 4
  else if unit_type == "recon" then 10
  else 4

-- Sum terrain costs along a path
fn path_cost(board: Zone, path: List Cell) -> Int =
  path |> map (\c -> terrain_cost board c) |> sum

-- Check if a unit can afford to enter a destination cell
fn can_enter(board: Zone, unit: Component, dest: Cell) -> Bool =
  terrain_cost board dest <= movement_points_for unit

-- Count how many adjacent cells a unit could enter from its position
fn reachable_neighbors(board: Zone, unit: Component, from: Cell) -> Int =
  adjacent board from
  |> filter (\c -> terrain_cost board c <= movement_points_for unit)
  |> length

-- Attack strength modifier: attacker gets no terrain bonus, defender does
fn effective_defense(board: Zone, defender: Component) -> Int =
  let base_strength = rank defender in
  match position defender with
  | Some cell -> base_strength + defense_bonus board cell
  | None -> base_strength

-- Check if a cell is an objective hex
fn is_objective(board: Zone, c: Cell) -> Bool =
  cell_property board (col c) (row c) "objective" == "true"

-- Count objectives controlled by a player
fn count_objectives(board: Zone, p: Player) -> Int =
  components board
  |> filter (\c -> owner c == Some p)
  |> filter (\c -> unit_on_objective board c)
  |> length

fn unit_on_objective(board: Zone, comp: Component) -> Bool =
  match position comp with
  | Some cell -> is_objective board cell
  | None -> false

-- Count surviving units for a player
fn count_units(board: Zone, p: Player) -> Int =
  components board
  |> filter (\c -> owner c == Some p)
  |> length

-- VP scoring: units alive + objectives held
fn score(state: State) -> List Score =
  let board = zone state "board" in
  players state |> map (\p ->
    let units = count_units board p in
    let objectives = count_objectives board p * 5 in
    { player = name p
    , points = units + objectives
    , breakdown = [ { category = "units", points = units }
                  , { category = "objectives", points = objectives }
                  ]
    })

-- ============================================================
-- Supply Line Tracing
-- ============================================================
--
-- A unit is "in supply" if a contiguous path of passable hexes
-- connects it to a supply source: a friendly HQ or the friendly
-- map edge (col 0 for Blue, col 19 for Red).
--
-- The path must not pass through:
--   - Enemy-occupied hexes
--   - Unoccupied hexes in enemy ZOC (friendly-occupied ZOC hexes OK)
--   - Impassable terrain (mountain, river)
--
-- Uses flood_fill for efficient reachability without recursion.

-- Check if a cell is in enemy ZOC (any adjacent cell has an enemy unit).
-- Inlined here because Felt has no imports; mirrors zoc.felt logic.
fn in_enemy_zoc_supply(board: Zone, target: Cell, player: Player) -> Bool =
  adjacent board target
  |> any (\adj ->
    cell_at board (col adj) (row adj)
    |> map_opt (\comp -> owner comp != Some player and is_some (owner comp))
    |> unwrap_or false)

-- Check if a cell is on the friendly map edge.
-- Blue supplies from col 0, Red supplies from col 19.
fn is_friendly_edge(c: Cell, player: Player) -> Bool =
  let player_name = name player in
  if player_name == "Blue" then col c == 0
  else col c == 19

-- Check if a cell has a friendly HQ unit.
fn has_friendly_hq(board: Zone, c: Cell, player: Player) -> Bool =
  cell_at board (col c) (row c)
  |> map_opt (\comp -> type_of comp == "headquarters" and owner comp == Some player)
  |> unwrap_or false

-- Check if a cell is a supply source (friendly HQ or friendly map edge).
fn is_supply_source(board: Zone, c: Cell, player: Player) -> Bool =
  is_friendly_edge c player or has_friendly_hq board c player

-- Check if a cell is passable for supply line tracing.
-- Impassable: mountain, river.
-- Enemy-occupied: blocked.
-- Empty + enemy ZOC (without friendly presence): blocked.
-- Friendly-occupied or empty without enemy ZOC: passable.
fn is_supply_passable(board: Zone, c: Cell, player: Player) -> Bool =
  let terrain = cell_property board (col c) (row c) "terrain" in
  if terrain == "mountain" then false
  else if terrain == "river" then false
  else
    cell_at board (col c) (row c)
    |> map_opt (\comp -> owner comp == Some player)
    |> unwrap_or (not (in_enemy_zoc_supply board c player))

-- Find all cells reachable from a starting cell through supply-passable hexes.
-- Uses flood_fill (BFS) — no recursion needed.
fn supply_reachable(board: Zone, start: Cell, player: Player) -> Set Cell =
  flood_fill board start (\c -> is_supply_passable board c player)

-- Check if a unit is in supply.
-- A unit is in supply if any cell reachable through passable hexes
-- is a supply source (friendly HQ or friendly map edge).
fn is_in_supply(state: State, board: Zone, unit: Component, player: Player) -> Bool =
  position unit
  |> map_opt (\cell ->
    is_supply_source board cell player
    or (supply_reachable board cell player
        |> to_list
        |> any (\c -> is_supply_source board c player)))
  |> unwrap_or false

-- Count units out of supply for a player.
fn count_out_of_supply(state: State, board: Zone, player: Player) -> Int =
  components board
  |> filter (\c -> owner c == Some player)
  |> filter (\c -> not (is_in_supply state board c player))
  |> length

-- ============================================================
-- Exploitation Phase
-- ============================================================

-- Exploitation eligibility: only armor and recon may exploit
fn can_exploit(comp: Component) -> Bool =
  let t = type_of comp in
  t == "armor" or t == "recon"

fn add1(x: Int) -> Int = x + 1

fn double(x: Int) -> Int = x * 2

fn quad(x: Int) -> Int = double (double x)

fn maxval(a: Int, b: Int) -> Int = if a > b then a else b

fn classify(x: Int) -> Int =
  if x > 0 then 1
  else if x == 0 then 0
  else -1

fn abs(x: Int) -> Int = if x > 0 then x else -x

fn factorial5() -> Int =
  let a = 1 in
  let b = a * 2 in
  let c = b * 3 in
  let d = c * 4 in
  let e = d * 5 in
  e

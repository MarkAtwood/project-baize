-- Combat Resolution Table (CRT) for hex wargames
--
-- Models a classic odds-ratio CRT: attackers surrounding a hex
-- contribute strength, terrain modifies defense, an odds column
-- is computed, and a die roll indexes into the result table.
--
-- Result codes: 0=NE, 1=AR, 2=EX, 3=DR, 4=DE

-- Unit attack strength by type
fn attack_strength(comp: Component) -> Int =
  let t = type_of comp in
  if t == "infantry" then 2
  else if t == "armor" then 6
  else if t == "mechanized" then 4
  else if t == "artillery" then 3
  else if t == "headquarters" then 0
  else 1

-- Unit defense strength by type
fn defense_strength(comp: Component) -> Int =
  let t = type_of comp in
  if t == "infantry" then 3
  else if t == "armor" then 4
  else if t == "mechanized" then 3
  else if t == "artillery" then 1
  else if t == "headquarters" then 1
  else 1

-- Terrain defense bonus from cell properties
fn terrain_defense_modifier(board: Zone, c: Cell) -> Int =
  let terrain = cell_property board (col c) (row c) "terrain" in
  if terrain == "mountain" then 3
  else if terrain == "forest" then 1
  else if terrain == "hills" then 2
  else if terrain == "town" then 2
  else 0

-- Map total_attack / total_defense ratio to a CRT column index
-- 0=1:3, 1=1:2, 2=1:1, 3=2:1, 4=3:1, 5=4:1, 6=5:1, 7=6:1+
fn compute_odds_column(total_attack: Int, total_defense: Int) -> Int =
  if total_defense <= 0 then 7
  else if total_attack <= 0 then 0
  else
    let ratio = total_attack * 10 / total_defense in
    if ratio <= 3 then 0
    else if ratio <= 5 then 1
    else if ratio <= 10 then 2
    else if ratio <= 20 then 3
    else if ratio <= 30 then 4
    else if ratio <= 40 then 5
    else if ratio <= 50 then 6
    else 7

-- CRT lookup: (column, die_roll 1-6) -> result code
-- 0=NE  1=AR  2=EX  3=DR  4=DE
fn crt_result(column: Int, die_roll: Int) -> Int =
  if column == 0 then
    if die_roll <= 4 then 1 else 0
  else if column == 1 then
    if die_roll <= 3 then 1
    else if die_roll <= 5 then 0
    else 2
  else if column == 2 then
    if die_roll <= 2 then 1
    else if die_roll <= 4 then 2
    else 3
  else if column == 3 then
    if die_roll == 1 then 1
    else if die_roll <= 3 then 2
    else 3
  else if column == 4 then
    if die_roll == 1 then 2
    else if die_roll <= 4 then 3
    else 4
  else if column == 5 then
    if die_roll == 1 then 2
    else if die_roll <= 3 then 3
    else 4
  else if column == 6 then
    if die_roll <= 2 then 3
    else 4
  else
    if die_roll == 1 then 3
    else 4

-- Human-readable result name
fn result_name(result_code: Int) -> String =
  if result_code == 0 then "no_effect"
  else if result_code == 1 then "attacker_retreat"
  else if result_code == 2 then "exchange"
  else if result_code == 3 then "defender_retreat"
  else "defender_eliminated"

-- Full combat resolution: given raw totals and a die roll,
-- return the result code
fn resolve_combat(total_attack: Int, total_defense: Int, die_roll: Int) -> Int =
  let column = compute_odds_column total_attack total_defense in
  crt_result column die_roll

-- Shift odds column by terrain advantage (clamp to 0..7)
fn adjusted_odds(total_attack: Int, total_defense: Int, terrain_bonus: Int) -> Int =
  let raw = compute_odds_column total_attack (total_defense + terrain_bonus) in
  if raw < 0 then 0
  else if raw > 7 then 7
  else raw

-- Combined defense: base strength + terrain modifier
fn effective_defense(comp: Component, board: Zone, c: Cell) -> Int =
  defense_strength comp + terrain_defense_modifier board c

-- ============================================================
-- Combat aftermath: step losses, retreat, mandatory attack,
-- advance after combat
-- ============================================================

-- A unit's current attack strength after step losses
fn current_attack(comp: Component) -> Int =
  let base = attack_strength comp in
  let step_loss_str = property comp "step_losses" in
  if step_loss_str == "1" then (base + 1) / 2
  else base

-- A unit's current defense strength after step losses
fn current_defense(comp: Component) -> Int =
  let base = defense_strength comp in
  let step_loss_str = property comp "step_losses" in
  if step_loss_str == "1" then (base + 1) / 2
  else base

-- Is a unit eliminated (all steps lost)?
fn is_eliminated(comp: Component) -> Bool =
  let steps_str = property comp "steps" in
  let step_loss_str = property comp "step_losses" in
  if steps_str == "1" then step_loss_str == "1"
  else if steps_str == "2" then step_loss_str == "2"
  else false

-- Helper: check if a cell is in enemy ZOC (inlined from zoc.felt)
fn crt_in_enemy_zoc(board: Zone, target: Cell, player: Player) -> Bool =
  adjacent board target
  |> any (\adj ->
    cell_at board (col adj) (row adj)
    |> map_opt (\comp -> owner comp != Some player and is_some (owner comp))
    |> unwrap_or false)

-- Helper: count enemy units adjacent to a cell (inlined from zoc.felt)
fn crt_adjacent_enemy_count(board: Zone, target: Cell, player: Player) -> Int =
  adjacent board target
  |> filter (\adj ->
    cell_at board (col adj) (row adj)
    |> map_opt (\comp -> owner comp != Some player and is_some (owner comp))
    |> unwrap_or false)
  |> length

-- Check if a retreat hex is valid for a defender
fn is_valid_retreat(board: Zone, from: Cell, to: Cell, retreater: Player) -> Bool =
  let to_terrain = cell_property board (col to) (row to) "terrain" in
  if to_terrain == "river" then false
  else if to_terrain == "mountain" then false
  else
    match cell_at board (col to) (row to) with
    | Some comp -> owner comp == Some retreater
    | None -> true

-- Retreat through enemy ZOC causes extra step loss
fn retreat_zoc_penalty(board: Zone, retreat_cell: Cell, retreater: Player) -> Int =
  if crt_in_enemy_zoc board retreat_cell retreater then 1
  else 0

-- Check if a player has units adjacent to enemies (must attack)
fn must_attack(board: Zone, player: Player) -> Bool =
  components board
  |> filter (\comp -> owner comp == Some player)
  |> any (\comp ->
    match position comp with
    | Some cell -> crt_adjacent_enemy_count board cell player > 0
    | None -> false)

-- List units that must attack (adjacent to enemies)
fn units_that_must_attack(board: Zone, player: Player) -> List Component =
  components board
  |> filter (\comp -> owner comp == Some player)
  |> filter (\comp ->
    match position comp with
    | Some cell -> crt_adjacent_enemy_count board cell player > 0
    | None -> false)

-- Check if attacker can advance into a vacated hex
fn can_advance_into(board: Zone, target: Cell) -> Bool =
  match cell_at board (col target) (row target) with
  | Some x -> false
  | None -> true

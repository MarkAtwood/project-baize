{
  "_comment": "Cross-implementation legal move test vectors for the Baize game engine. Each test case defines a board state and the exhaustive set of legal moves. Moves are sorted lexicographically by (component, from, to) for deterministic comparison.",
  "_version": "1.0.0",

  "test_cases": [
    {
      "name": "king_center_empty_board",
      "description": "King at center of 8x8 board, all 8 adjacent squares available",
      "game_definition": {
        "game": { "name": "Chess Moves Test", "players": ["white", "black"], "information": "perfect" },
        "zones": {
          "board": { "zone_type": "grid", "dimensions": [8, 8], "visibility": "public" }
        },
        "components": {
          "king": {
            "owner": "per_player",
            "count": 1,
            "movement": [{ "primitive": "step", "direction": "adjacent" }]
          }
        },
        "turn_order": { "type": "alternating", "players": ["white", "black"], "actions_per_turn": 1, "mandatory": true },
        "end_conditions": [{ "result": "win", "condition": "checkmate" }],
        "authority": { "server_only": [], "client_verifiable": ["all"] }
      },
      "setup": [
        { "string_id": "wk", "component_type": "king", "owner": "white", "col": 4, "row": 4 }
      ],
      "current_player": "white",
      "expected_move_count": 8,
      "expected_moves": [
        { "component": "wk", "from": "4,4", "to": "3,3" },
        { "component": "wk", "from": "4,4", "to": "3,4" },
        { "component": "wk", "from": "4,4", "to": "3,5" },
        { "component": "wk", "from": "4,4", "to": "4,3" },
        { "component": "wk", "from": "4,4", "to": "4,5" },

          "score_track": { "zone_type": "track", "length": 20, "visibility": "public" },
          "reserve": { "zone_type": "ordered_stack", "per_player": true, "visibility": { "private": "owner" } },
          "power": { "zone_type": "counter", "per_player": true, "visibility": "public" }
        },
        "components": {

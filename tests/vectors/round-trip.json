    {
      "name": "poker_like_with_counters",
      "description": "Poker-like game with global and per-player counters, a hidden deck (ordered_stack), and per-player hand (set) zones with face-down cards.",
      "game_definition": {
        "game": { "name": "Poker-Like", "players": { "min": 3, "max": 6 }, "information": "imperfect" },
        "zones": {
          "deck": { "zone_type": "ordered_stack", "visibility": "hidden" },
          "discard": { "zone_type": "ordered_stack", "visibility": "public" },
          "pot_zone": { "zone_type": "counter", "visibility": "public" },
          "hand": { "zone_type": "set", "per_player": true, "visibility": { "private": "owner" } }
        },
        "components": {
          "card": { "count": 52 }
        },
        "turn_order": { "type": "round_robin" },
        "end_conditions": [{ "result": "win", "condition": "last_player_standing" }],
        "authority": { "server_only": ["deal"], "client_verifiable": ["bet", "fold"] }
      },
      "setup": {
        "status": "in_progress",
        "components": [
          { "string_id": "card-AH", "component_type": "card", "owner": "player_0", "facing": "face_down", "properties": { "suit": "hearts", "rank": "A" } },
          { "string_id": "card-KS", "component_type": "card", "owner": "player_0", "facing": "face_down", "properties": { "suit": "spades", "rank": "K" } },
          { "string_id": "card-QD", "component_type": "card", "owner": "player_1", "facing": "face_down", "properties": { "suit": "diamonds", "rank": "Q" } },
          { "string_id": "card-JC", "component_type": "card", "owner": "player_1", "facing": "face_down", "properties": { "suit": "clubs", "rank": "J" } },
          { "string_id": "card-10H", "component_type": "card", "owner": "player_2", "facing": "face_down", "properties": { "suit": "hearts", "rank": "10" } },
          { "string_id": "card-2S", "component_type": "card", "owner": null, "facing": "face_down" },
          { "string_id": "card-3S", "component_type": "card", "owner": null, "facing": "face_down" },
          { "string_id": "card-5D", "component_type": "card", "owner": null, "facing": "face_up" }
        ],
        "placements": [
          { "component_index": 0, "player_zone": { "player": "player_0", "zone": "hand" } },
          { "component_index": 1, "player_zone": { "player": "player_0", "zone": "hand" } },
          { "component_index": 2, "player_zone": { "player": "player_1", "zone": "hand" } },
          { "component_index": 3, "player_zone": { "player": "player_1", "zone": "hand" } },
          { "component_index": 4, "player_zone": { "player": "player_2", "zone": "hand" } },
          { "component_index": 5, "zone": "deck" },
          { "component_index": 6, "zone": "deck" },
          { "component_index": 7, "zone": "discard" }
        ],
        "counters": {
          "pot": 150,
          "round": 3
        },
        "player_counters": {
          "player_0": { "chips": 500, "bet": 50 },
          "player_1": { "chips": 300, "bet": 50 },
          "player_2": { "chips": 700, "bet": 50 }
